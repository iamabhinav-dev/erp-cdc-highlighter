{
  "manifest_version": 3,
  "name": "ERP Table Row Highlighter",
  "version": "1.0.0",
  "description": "Smart row highlighter for IIT Kharagpur ERP CDC Placement portal. Works seamlessly on Firefox and Brave.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "ERP Row Highlighter"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://erp.iitkgp.ac.in/*",
    "*://*.iitkgp.ac.in/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://erp.iitkgp.ac.in/*",
        "*://*.iitkgp.ac.in/*",
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "erp-row-highlighter@iitkgp.ac.in",
      "strict_min_version": "109.0"
    }
  }
}
